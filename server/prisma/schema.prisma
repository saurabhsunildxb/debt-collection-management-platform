// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  COLLECTION_AGENT
}

enum LoanStatus {
  ACTIVE
  CLOSED
  DEFAULTED
  OVERDUE
}

enum ActivityType {
  CALL
  VISIT
  EMAIL
  SMS
  PAYMENT_REMINDER
}

enum ActivityOutcome {
  CONTACTED
  NO_ANSWER
  PROMISE_TO_PAY
  REFUSED
  PAID
  LEFT_MESSAGE
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(COLLECTION_AGENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Customers assigned to this agent
  assignedCustomers Customer[]           @relation("AgentCustomers")

  // Collection activities logged by this agent
  activities        CollectionActivity[]
}

model Customer {
  id              String   @id @default(uuid())
  fullName        String
  email           String?  @unique
  phone           String
  address         String?
  nationalId      String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Optional FK to the assigned Collection Agent
  assignedAgentId String?
  assignedAgent   User?    @relation("AgentCustomers", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  // Cascade: deleting a customer removes their loans and activities
  loans           Loan[]               @relation("CustomerLoans")
  activities      CollectionActivity[] @relation("CustomerActivities")
}

model Loan {
  id                 String     @id @default(uuid())
  customerId         String
  principalAmount    Decimal    @db.Decimal(12, 2)
  interestRate       Decimal    @db.Decimal(5, 2)   // e.g. 12.50 = 12.5%
  totalAmount        Decimal    @db.Decimal(12, 2)
  amountPaid         Decimal    @db.Decimal(12, 2)  @default(0)
  outstandingBalance Decimal    @db.Decimal(12, 2)
  dueDate            DateTime
  status             LoanStatus @default(ACTIVE)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Cascade: deleting a loan removes its repayments
  customer           Customer   @relation("CustomerLoans", fields: [customerId], references: [id], onDelete: Cascade)
  repayments         Repayment[]
}

model Repayment {
  id          String   @id @default(uuid())
  loanId      String
  amount      Decimal  @db.Decimal(12, 2)
  paymentDate DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())

  // Cascade: deleting a loan removes its repayments
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model CollectionActivity {
  id           String          @id @default(uuid())
  agentId      String
  customerId   String
  activityType ActivityType
  outcome      ActivityOutcome
  notes        String?
  followUpDate DateTime?
  createdAt    DateTime        @default(now())

  // Restrict: prevent deleting a user/customer who has activities (use SetNull or keep Restrict)
  agent        User            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  customer     Customer        @relation("CustomerActivities", fields: [customerId], references: [id], onDelete: Cascade)
}
